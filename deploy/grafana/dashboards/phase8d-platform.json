      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{
        "expr": "sum(rate(strata_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(strata_http_requests_total[5m])), 0.001)",
        "refId": "A"
      }],
      "title": "API 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "strata-prometheus"},
