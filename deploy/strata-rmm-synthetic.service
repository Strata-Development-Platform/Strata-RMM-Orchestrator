[Unit]
Description=Strata RMM independent production-path synthetic check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=strata-rmm
Group=strata-rmm
EnvironmentFile=/etc/strata-rmm/synthetic.env
ExecStart=/usr/local/bin/strata-rmm synthetic --base-url ${STRATA_SYNTHETIC_BASE_URL} --timeout 10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

