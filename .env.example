# Strata RMM Orchestrator — Environment Configuration Template
# Copy to .env and fill in your values.
# Never commit .env files to version control.

# JWT signing secret (minimum 32 characters, required)
JWT_SECRET=
STRATA_ALLOW_LEGACY_DEPLOYMENT_ENROLLMENT=false

# PostgreSQL / TimescaleDB connection
TIMESCALE_DSN=postgres://user:password@localhost:5432/strata_rmm?sslmode=disable

# NATS server URL
NATS_URL=nats://localhost:4222
# Comma-separated agent-reachable URLs. Production values must use tls:// or nats+tls://.
NATS_ADVERTISE_URLS=nats://localhost:4222

# API listen address
API_ADDR=:8080

# Storage configuration
STORAGE_BACKEND=local
STORAGE_BUCKET=strata-recordings
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Test credentials (used by integration tests)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
